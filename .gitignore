# AI Technician - Offline Windows Technician USB
# Ignore large binaries - download via AI-TECH/download_models.ps1

# Models - NEVER commit big GGUF files to GitHub (100MB limit)
*.gguf
AI-TECH/models/*.gguf
AI-TECH/models/*.bin

# llama.cpp binaries
AI-TECH/llama/*.exe
AI-TECH/llama/*.dll
AI-TECH/llama/*.zip
AI-TECH/llama/*.tar.gz

# Logs & temp
AI-TECH/logs/*
!AI-TECH/logs/.gitkeep
*.log
*.tmp
*.temp
Temp/

# Driver packs (too big for Git, add via USB release)
AI-TECH/drivers/*
!AI-TECH/drivers/.gitkeep
AI-TECH/tools/*
!AI-TECH/tools/.gitkeep

# Local release staging (assets uploaded to GitHub Releases, not committed)
release/
*.gguf
*.zip
!*.zip.example

# Windows / IDE
.vscode/
.idea/
*.sln
obj/
bin/
*.user

# Secrets
.env
.env.*
.env.local
config.local.json
